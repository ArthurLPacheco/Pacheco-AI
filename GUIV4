class Bridge(QObject):
    sinalJS       = pyqtSignal(str)
    sinalEnviar   = pyqtSignal(str)
    sinalNova     = pyqtSignal()
    sinalCarregar = pyqtSignal(str)

    def __init__(self, view, ai):
        super().__init__()
        self.view     = view
        self.ai       = ai
        self._deletados: set[str] = set()
        self.sinalJS.connect(self._executar_js)
        self.sinalEnviar.connect(self._processar)
        self.sinalNova.connect(self._nova_sessao)
        self.sinalCarregar.connect(self._carregar_sessao)

    def _executar_js(self, code):
        self.view.page().runJavaScript(code)

    def js(self, code):
        self.sinalJS.emit(code)

    # ── Slots chamados pelo JS ──

    @pyqtSlot(str)
    def enviarMensagem(self, texto):
        self.sinalEnviar.emit(texto)

    @pyqtSlot()
    def uiPronta(self):
        pass

    @pyqtSlot()
    def novaSessao(self):
        self.sinalNova.emit()

    @pyqtSlot(str)
    def carregarSessao(self, id_sessao):
        self.sinalCarregar.emit(id_sessao)

    @pyqtSlot(str, str)
    def renomearSessao(self, id_sessao, novo_nome):
        novo_nome = novo_nome.strip()[:80]
        self.ai.db.renomear_sessao(id_sessao, novo_nome)
        if self.ai.sessao_atual and self.ai.sessao_atual.id == id_sessao:
            self.ai.sessao_atual.nome = novo_nome
        self._atualizar_lista_sessoes()

    @pyqtSlot(str)
    def renomearSessaoAtual(self, novo_nome):
        novo_nome = novo_nome.strip()[:80]
        self.ai.sessao_atual.nome = novo_nome
        self.ai.db.renomear_sessao(self.ai.sessao_atual.id, novo_nome)
        self._atualizar_lista_sessoes()

    @pyqtSlot(str)
    def deletarSessao(self, id_sessao):
        self._deletados.add(id_sessao)
        self.ai.db.deletar_sessao(id_sessao)
        self._atualizar_lista_sessoes()

    @pyqtSlot(str)
    def copiarParaClipboard(self, texto):
        clipboard = QApplication.clipboard()
        clipboard.setText(texto)

    # ── Lógica interna ──

    def _nova_sessao(self):
        self.ai.nova_sessao()

    def _carregar_sessao(self, id_sessao):
        ok = self.ai.carregar_sessao(id_sessao)
        if ok:
            s         = self.ai.sessao_atual
            msgs      = self.ai.db.obter_mensagens(id_sessao)
            msgs_json = json.dumps(msgs, ensure_ascii=False)
            safe_nome = s.nome.replace("'", "\\'")
            safe_msgs = msgs_json.replace("\\","\\\\").replace("'","\\'").replace("\n","\\n")
            self.js(f"document.getElementById('chat-nome').value='{safe_nome}'.toUpperCase();")
            self.js(f"renderizarHistorico('{safe_msgs}');")
            self.js(f"sessaoAtualId='{id_sessao}';")

    def _atualizar_lista_sessoes(self):
        todas     = self.ai.db.listar_sessoes()
        filtradas = [s for s in todas if s["id"] not in self._deletados]
        sess_json = json.dumps(filtradas, ensure_ascii=False)
        safe      = sess_json.replace("\\","\\\\").replace("'","\\'")
        self.js(f"atualizarListaSessoes('{safe}');")

    def _processar(self, texto):
        threading.Thread(target=self._rodar, args=(texto,), daemon=True).start()

    def _rodar(self, texto):
        original_stdout  = sys.stdout
        bridge_ref       = self
        ultimo_resultado = {}

        class StreamCapture:
            def write(self, t):
                if t:
                    safe = (t.replace("\\","\\\\").replace("`","\\`")
                              .replace("'","\\'").replace("\n","\\n").replace("\r",""))
                    bridge_ref.sinalJS.emit(f"appendStream('{safe}')")
            def flush(self): pass

        sys.stdout    = StreamCapture()
        resultado_str = ""
        try:
            if texto.lower() in ("/sair", "sair", "exit"):
                self.sinalJS.emit("window.close()")
                return

            _orig_processar = self.ai.processar
            def _processar_interceptado(pergunta):
                res = _orig_processar(pergunta)
                ultimo_resultado.update(res)
                return res
            self.ai.processar = _processar_interceptado

            self.ai.rotear(texto)

            self.ai.processar = _orig_processar

            # ─── RENOMEIO AUTOMÁTICO FORÇADO ───
            if self.ai.sessao_atual.nome == "Nova conversa":
                try:
                    msgs = self.ai.db.obter_mensagens(self.ai.sessao_atual.id, 5)
                    primeira_msg = ""
                    for m in msgs:
                        if m["role"] == "user":
                            primeira_msg = m["texto"]
                            break
                    if primeira_msg:
                        nome_gerado = self.ai.chat.gerar_nome(primeira_msg)
                        if nome_gerado != "Nova conversa":
                            self.ai.sessao_atual.nome = nome_gerado
                            self.ai.db.renomear_sessao(self.ai.sessao_atual.id, nome_gerado)
                            self._atualizar_lista_sessoes()
                except Exception:
                    pass

        except SystemExit:
            self.sinalJS.emit("window.close()")
            return
        except Exception as e:
            resultado_str = f"❌ Erro: {e}"
        finally:
            sys.stdout = original_stdout

        modo   = self.ai.modo_atual
        labels = {"chat": "MODO: CONVERSA", "codigo": "MODO: CÓDIGO", "auto": "MODO: AUTO"}
        label      = labels.get(modo, modo)
        nome_atual = self.ai.sessao_atual.nome.replace("'", "\\'")
        safe_res   = resultado_str.replace("'", "\\'")

        sess_id = self.ai.sessao_atual.id

        self.ai.db.renomear_sessao(sess_id, self.ai.sessao_atual.nome)

        codigo_json = "null"
        if ultimo_resultado.get("codigo"):
            cd = {
                "codigo":  ultimo_resultado.get("codigo", ""),
                "sucesso": ultimo_resultado.get("sucesso", None),
            }
            safe_cd = json.dumps(cd, ensure_ascii=False).replace("\\","\\\\").replace("'","\\'").replace("\n","\\n")
            codigo_json = f"'{safe_cd}'"

        self.sinalJS.emit(f"document.getElementById('modeLabel').textContent='{label}';")
        self.sinalJS.emit(f"endStream('{safe_res}','{nome_atual}',{codigo_json},'{sess_id}');")
        self._atualizar_lista_sessoes()


