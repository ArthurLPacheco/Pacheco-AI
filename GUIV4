  opacity:0;transition:all 0.2s ease;pointer-events:none;z-index:999;}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

#boot-overlay{position:fixed;inset:0;background:var(--bg);z-index:9000;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;
  animation:bootFade 0.5s ease 2.4s forwards;}
@keyframes bootFade{to{opacity:0;pointer-events:none}}
.boot-title{font-family:'Orbitron',sans-serif;font-weight:900;font-size:40px;
  letter-spacing:14px;color:var(--purple2);text-shadow:0 0 55px var(--purple-glow);}
.boot-sub{font-size:10px;color:var(--dim);letter-spacing:7px;overflow:hidden;
  white-space:nowrap;animation:typeIn 1.5s steps(20) forwards;width:0;}
@keyframes typeIn{to{width:100%}}
.boot-progress{width:280px;height:1px;background:var(--border);margin-top:8px;overflow:hidden;}
.boot-progress-fill{height:100%;background:linear-gradient(90deg,var(--purple4),var(--purple2),var(--purple3));
  animation:bootFill 2.2s ease-out forwards;}
.boot-lines{font-size:11px;color:var(--dim);letter-spacing:2px;text-align:left;width:300px;line-height:2.2;}
.boot-line{opacity:0;animation:lineAppear 0.1s forwards;}
.boot-line:nth-child(1){animation-delay:0.2s}.boot-line:nth-child(2){animation-delay:0.5s}
.boot-line:nth-child(3){animation-delay:0.8s}.boot-line:nth-child(4){animation-delay:1.1s}
.boot-line:nth-child(5){animation-delay:1.4s}
@keyframes lineAppear{to{opacity:1}}
.boot-ok{color:var(--green);}
</style>
</head>
<body>

<div id="boot-overlay">
  <div class="boot-title">PACHECO</div>
  <div class="boot-sub">LIMA CORP · SISTEMA Ω · v5.3</div>
  <div class="boot-progress"><div class="boot-progress-fill"></div></div>
  <div class="boot-lines">
    <div class="boot-line">&gt; NÚCLEO NEURAL v5.3 CARREGADO... <span class="boot-ok">[OK]</span></div>
    <div class="boot-line">&gt; SQLITE PERSISTENTE ATIVO... <span class="boot-ok">[OK]</span></div>
    <div class="boot-line">&gt; SPLIT-SCREEN INICIALIZADO... <span class="boot-ok">[OK]</span></div>
    <div class="boot-line">&gt; OLLAMA LOCAL ESTÁVEL... <span class="boot-ok">[OK]</span></div>
    <div class="boot-line">&gt; OI, ARTHUR. 👋</div>
  </div>
</div>

<div id="app">
  <!-- SIDEBAR -->
  <div id="sidebar">
    <div class="brand-block">
      <div class="brand-logo">
        <div class="hex-logo">
          <svg width="46" height="46" viewBox="0 0 50 50" fill="none">
            <polygon points="25,2 46,13.5 46,36.5 25,48 4,36.5 4,13.5"
              fill="rgba(139,44,245,0.07)" stroke="#8b2cf5" stroke-width="1.5"/>
            <polygon points="25,9 40,17.5 40,32.5 25,41 10,32.5 10,17.5"
              fill="rgba(139,44,245,0.04)" stroke="rgba(168,85,247,0.3)" stroke-width="1"/>
            <circle cx="25" cy="25" r="7" fill="none" stroke="#8b2cf5" stroke-width="1.5"
              stroke-dasharray="4 2"
              style="animation:rotateSlow 6s linear infinite;transform-origin:25px 25px"/>
            <circle cx="25" cy="25" r="2.5" fill="#a855f7"/>
          </svg>
        </div>
        <div class="brand-text">
          <div class="brand-name">Pacheco AI</div>
          <div class="brand-omega">Ω · Lima Corp</div>
          <div class="brand-corp">v5.3 · by Arthur Lima</div>
        </div>
      </div>
      <div class="boot-bar"><div class="boot-bar-fill"></div></div>
    </div>

    <div class="mode-hud">
      <div class="mode-dot" id="modeDot"></div>
      <span class="mode-text" id="modeLabel">MODO: CONVERSA</span>
    </div>

    <div class="nav-section">
      <div class="nav-label">Módulos</div>
      <button class="nav-btn active" id="btn-chat" onclick="setMode('chat')">
        <span class="nav-icon">◈</span> Chat / Conversa
      </button>
      <button class="nav-btn" id="btn-cod" onclick="setMode('cod')">
        <span class="nav-icon">◧</span> Código / Dev
      </button>
      <button class="nav-btn" id="btn-auto" onclick="setMode('auto')">
        <span class="nav-icon">◉</span> Automático
      </button>
    </div>

    <button id="btn-nova" onclick="novaConversa()">
      <span class="nova-icon">⊕</span> NOVA SESSÃO
    </button>

    <div class="sep"></div>

    <div class="hist-header">
      <div class="nav-label">Histórico</div>
    </div>
    <div id="lista-sessoes">
      <div class="sess-empty" id="sess-empty">// Sem sessões<br>salvas ainda</div>
    </div>

    <div class="status-block">
      <div class="status-row">
        <div class="status-led" id="statusDot"></div>
        <span class="status-txt" id="statusText">VERIFICANDO...</span>
      </div>
      <div class="model-chip" id="modelTag">carregando</div>
    </div>
  </div>

  <!-- MAIN -->
  <div id="main">
    <div id="header">
      <div class="header-left">
        <input id="chat-nome" type="text" value="NOVA SESSÃO" maxlength="80"
          title="Clique para renomear"
          onblur="salvarNome()"
          onkeydown="if(event.key==='Enter')this.blur();if(event.key==='Escape')this.blur()"/>
      </div>
      <div class="header-right">
        <div class="hud-clock" id="hud-clock">--:--:--</div>
        <button id="toggle-code" onclick="toggleCodePanel()">◧ CÓDIGO</button>
      </div>
    </div>

    <div id="content-area">
      <!-- Chat (esq) -->
      <div id="chat-panel">
        <div id="messages">
          <div id="welcome">
            <svg width="120" height="120" viewBox="0 0 140 140" fill="none" style="animation:rotateSlow 25s linear infinite">
              <circle cx="70" cy="70" r="62" stroke="rgba(139,44,245,0.1)" stroke-width="1" stroke-dasharray="5 5"/>
              <circle cx="70" cy="70" r="46" stroke="rgba(139,44,245,0.2)" stroke-width="1" stroke-dasharray="2 7"/>
              <circle cx="70" cy="70" r="30" stroke="rgba(168,85,247,0.4)" stroke-width="1.5"/>
              <polygon points="70,10 79,58 120,70 79,82 70,130 61,82 20,70 61,58"
                fill="none" stroke="#8b2cf5" stroke-width="1.5"/>
              <circle cx="70" cy="70" r="7" fill="none" stroke="#a855f7" stroke-width="2"/>
              <circle cx="70" cy="70" r="2.5" fill="#a855f7" style="filter:drop-shadow(0 0 7px #a855f7)"/>
            </svg>
            <div>
              <div class="welcome-title">PACHECO</div>
              <div class="welcome-omega">AI Ω — LIMA CORP</div>
            </div>
            <div class="welcome-sub">Sistema online · Pronto, Arthur</div>
            <div class="welcome-chips">
              <div class="wchip"><div class="wchip-dot"></div> NEURAL ATIVO</div>
              <div class="wchip">
                <div class="wchip-dot" style="background:var(--amber);box-shadow:0 0 7px var(--amber)"></div>
                SQLite ON
              </div>
            </div>
          </div>
        </div>

        <div id="input-area">
          <div class="input-hud-row">
            <span class="input-hud-tag">Input ▸▸</span>
            <div class="input-hud-line"></div>
            <span class="input-hud-tag" id="charCount">0</span>
          </div>
          <div class="input-wrap">
            <textarea id="input" rows="1" placeholder="// mensagem para o Pacheco..."></textarea>
            <button id="send-btn" onclick="sendMessage()">▶</button>
          </div>
          <div class="input-hint">[ ▶ → enviar ] · [ /cod · /chat · /auto · /abrir url · /modulos ]</div>
        </div>
      </div>

      <!-- Resize handle -->
      <div id="resize-handle" onmousedown="startResize(event)"></div>

      <!-- Code panel (dir) -->
      <div id="code-panel">
        <div class="code-header">
          <div class="code-title">
            <div class="code-dot"></div>
            CÓDIGO GERADO
          </div>
          <div class="code-actions">
            <button class="code-btn" id="copy-btn" onclick="copiarCodigo()">COPIAR</button>
            <button class="code-btn" onclick="limparCodigo()">LIMPAR</button>
          </div>
        </div>
        <div id="code-content">
          <pre id="code-display"><span class="code-placeholder">// Aqui aparece o código gerado
// pelo modo /cod, limpo e
// pronto pra copiar pro VS Code</span></pre>
        </div>
        <div class="code-status">
          <div class="code-status-dot" id="code-status-dot"></div>
          <span id="code-status-text">aguardando código...</span>
        </div>
      </div>

    </div><!-- /content-area -->
  </div><!-- /main -->
</div>

<!-- Modal -->
<div id="modal-overlay" onclick="fecharModal(event)">
  <div id="modal">
    <div class="modal-title">◈ Renomear Sessão</div>
    <input id="modal-input" type="text" maxlength="80" placeholder="// nome da sessão..."
      onkeydown="if(event.key==='Enter')confirmarRenomear();if(event.key==='Escape')fecharModal()"/>
    <div class="modal-btns">
      <button class="modal-btn cancel" onclick="fecharModal()">Cancelar</button>
      <button class="modal-btn confirm" onclick="confirmarRenomear()">Confirmar</button>
    </div>
  </div>
</div>
<div id="toast"></div>

<script>
  // ─── Estado global ───
  let modoAtual = 'chat';
  let ocupado   = false;
  let streamBubble = null;
  let streamContent = '';
  let sessaoAtualId = null;
  let renomearSessId = null;
  let codigoPainelVisivel = true;
  let codigoAtual = '';
  const deletados = new Set();

  // ─── FIX: Bridge com retry ───
  let _bridgeReady = false;
  let _pendingCalls = [];

  function _withBridge(fn) {
    if (_bridgeReady && window.bridge) {
      fn(window.bridge);
    } else {
      _pendingCalls.push(fn);
    }
  }

  function _initBridge() {
    _bridgeReady = true;
    const pending = _pendingCalls.splice(0);
    pending.forEach(fn => { try { fn(window.bridge); } catch(e) {} });
    window.bridge.uiPronta();
    console.log('[Pacheco] Bridge iniciada com sucesso.');
  }

  // ─── Resize ───
  let resizing = false, resizeStartX = 0, resizeStartW = 0;
  function startResize(e) {
    resizing = true;
    resizeStartX = e.clientX;
    resizeStartW = document.getElementById('code-panel').offsetWidth;
    document.getElementById('resize-handle').classList.add('dragging');
    document.addEventListener('mousemove', doResize);
    document.addEventListener('mouseup', stopResize);
    e.preventDefault();
  }
  function doResize(e) {
    if (!resizing) return;
    const diff = resizeStartX - e.clientX;
    const newW = Math.max(260, Math.min(700, resizeStartW + diff));
    document.getElementById('code-panel').style.width = newW + 'px';
  }
  function stopResize() {
    resizing = false;
    document.getElementById('resize-handle').classList.remove('dragging');
    document.removeEventListener('mousemove', doResize);
    document.removeEventListener('mouseup', stopResize);
  }

  function toggleCodePanel() {
    const cp = document.getElementById('code-panel');
    const rh = document.getElementById('resize-handle');
    codigoPainelVisivel = !codigoPainelVisivel;
    cp.classList.toggle('hidden', !codigoPainelVisivel);
    rh.style.display = codigoPainelVisivel ? '' : 'none';
    document.getElementById('toggle-code').textContent = codigoPainelVisivel ? '◧ CÓDIGO' : '◨ CÓDIGO';
  }

  function atualizarCodigo(codigo, sucesso) {
    codigoAtual = codigo;
    const el = document.getElementById('code-display');
    el.textContent = codigo;
    const dot = document.getElementById('code-status-dot');
    const txt = document.getElementById('code-status-text');
    dot.className = 'code-status-dot ' + (sucesso === true ? 'ok' : sucesso === false ? 'fail' : '');
    txt.textContent = sucesso === true ? '✅ Executado com sucesso'
                    : sucesso === false ? '❌ Falhou na execução'
                    : 'pendente...';
  }

  function copiarCodigo() {
    if (!codigoAtual) return;
    _withBridge(b => {
      b.copiarParaClipboard(codigoAtual);
      const btn = document.getElementById('copy-btn');
      btn.textContent = 'COPIADO!';
      btn.classList.add('copy-ok');
      setTimeout(() => { btn.textContent = 'COPIAR'; btn.classList.remove('copy-ok'); }, 1800);
    });
  }

  function limparCodigo() {
    codigoAtual = '';
    document.getElementById('code-display').innerHTML =
      '<span class="code-placeholder">// Código limpo\n// pronto pra próxima geração</span>';
    document.getElementById('code-status-dot').className = 'code-status-dot';
    document.getElementById('code-status-text').textContent = 'aguardando código...';
  }

  function tickClock() {
    const n = new Date(), p = v => String(v).padStart(2, '0');
    const el = document.getElementById('hud-clock');
    if (el) el.textContent = `${p(n.getHours())}:${p(n.getMinutes())}:${p(n.getSeconds())}`;
  }
  setInterval(tickClock, 1000); tickClock();

  window.onload = () => {
    autoResize();
    const inp = document.getElementById('input');
    inp.addEventListener('input', () => {
      autoResize();
      document.getElementById('charCount').textContent = inp.value.length;
    });
    inp.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    });
  };

  function setStatus(online, modelo, sessoesJson) {
    const dot  = document.getElementById('statusDot');
    const text = document.getElementById('statusText');
    const tag  = document.getElementById('modelTag');
    if (online) { dot.className = 'status-led online'; text.textContent = 'SISTEMA ONLINE'; }
    else        { dot.className = 'status-led offline'; text.textContent = 'OLLAMA OFFLINE'; }
    tag.textContent = modelo;
    try { renderizarSessoes(JSON.parse(sessoesJson || '[]')); } catch(e) {}
  }

  function atualizarListaSessoes(sessoesJson) {
    try { renderizarSessoes(JSON.parse(sessoesJson)); } catch(e) {}
  }

  // ─── RENDERIZAR SESSÕES (FIX DEFINITIVO) ───
  function renderizarSessoes(sessoes) {
    const lista = document.getElementById('lista-sessoes');
    const empty = document.getElementById('sess-empty');
    // Remove todos os itens exceto o placeholder
    Array.from(lista.children).forEach(el => { if (el.id !== 'sess-empty') el.remove(); });
    const visiveis = (sessoes || []).filter(s => !deletados.has(s.id));
    if (visiveis.length === 0) { empty.style.display = 'block'; return; }
    empty.style.display = 'none';

    visiveis.forEach(s => {
      const item = document.createElement('div');
      item.className = 'sess-item' + (s.id === sessaoAtualId ? ' active' : '');
      item.dataset.id = s.id;

      // Ícone
      const icon = document.createElement('span');
      icon.className = 'sess-icon';
      icon.textContent = '◈';
      item.appendChild(icon);

      // Info (nome e meta)
      const info = document.createElement('div');
      info.className = 'sess-info';
      const nomeSpan = document.createElement('span');
      nomeSpan.className = 'sess-nome';
      nomeSpan.title = s.nome;
      nomeSpan.textContent = s.nome;
      info.appendChild(nomeSpan);

      const metaSpan = document.createElement('span');
      metaSpan.className = 'sess-meta';
      const data = s.criada ? formatarData(s.criada) : '';
      const total = s.total || 0;
      metaSpan.textContent = `${data} · ${total} msg`;
      info.appendChild(metaSpan);
      item.appendChild(info);

      // Botões de ação (✎ e ✕)
      const actions = document.createElement('div');
      actions.className = 'sess-actions';

      const btnRenomear = document.createElement('button');
      btnRenomear.className = 'sess-btn';
      btnRenomear.title = 'Renomear';
      btnRenomear.textContent = '✎';
      btnRenomear.addEventListener('click', (e) => {
        e.stopPropagation();
        abrirModalRenomear(s.id, s.nome);
      });
      actions.appendChild(btnRenomear);

      const btnDeletar = document.createElement('button');
      btnDeletar.className = 'sess-btn del';
      btnDeletar.title = 'Deletar';
      btnDeletar.textContent = '✕';
      btnDeletar.addEventListener('click', (e) => {
        e.stopPropagation();
        deletarSessao(s.id);
      });
      actions.appendChild(btnDeletar);

      item.appendChild(actions);

      // Clique na linha carrega a sessão
      item.addEventListener('click', () => {
        carregarSessao(s.id);
      });

      lista.appendChild(item);
    });
  }

  function formatarData(iso) {
    try {
      const d = new Date(iso), h = new Date();
      if (d.toDateString() === h.toDateString())
        return d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
      return d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });
    } catch { return ''; }
  }

  function escHtml(t) {
    return (t || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  // ─── Sessões ───
  function novaConversa() {
    if (ocupado) return;
    limparCodigo();
    document.getElementById('messages').innerHTML = `
      <div id="welcome" style="display:flex;flex-direction:column;align-items:center;
        justify-content:center;flex:1;gap:16px;padding:32px;text-align:center">
        <div style="font-family:Orbitron,sans-serif;font-weight:900;font-size:26px;
          color:var(--purple2);letter-spacing:9px;">PACHECO</div>
        <div style="font-size:11px;color:var(--dim);letter-spacing:3px;text-transform:uppercase">
          Nova sessão · Pronto, Arthur
        </div>
      </div>`;
    document.getElementById('chat-nome').value = 'NOVA SESSÃO';
    sessaoAtualId = null;
    document.querySelectorAll('.sess-item').forEach(el => el.classList.remove('active'));
    _withBridge(b => b.novaSessao());
  }

  function carregarSessao(id) {
    if (ocupado || id === sessaoAtualId) return;
    sessaoAtualId = id;
    document.querySelectorAll('.sess-item').forEach(el =>
      el.classList.toggle('active', el.dataset.id === id));
    _withBridge(b => b.carregarSessao(id));
  }

  function renderizarHistorico(msgsJson) {
    try {
      const msgs = JSON.parse(msgsJson);
      const container = document.getElementById('messages');
      container.innerHTML = '';
      if (!msgs || msgs.length === 0) {
        container.innerHTML = '<div style="text-align:center;padding:36px;color:var(--dim);font-size:12px;letter-spacing:3px">// SESSÃO VAZIA</div>';
        return;
      }
      msgs.forEach(m => { if (m.role === 'user' || m.role === 'ai') appendMessage(m.role, m.texto, m.ts); });
    } catch(e) {}
  }

  function abrirModalRenomear(id, nomeAtual) {
    renomearSessId = id;
    const inp = document.getElementById('modal-input');
    inp.value = nomeAtual;
    document.getElementById('modal-overlay').classList.add('show');
    setTimeout(() => { inp.focus(); inp.select(); }, 50);
  }

  function fecharModal(event) {
    if (event && event.target !== document.getElementById('modal-overlay')) return;
    document.getElementById('modal-overlay').classList.remove('show');
    renomearSessId = null;
  }

  function confirmarRenomear() {
    const nome = document.getElementById('modal-input').value.trim();
    if (!nome) return;
    document.getElementById('modal-overlay').classList.remove('show');

    if (renomearSessId) {
      _withBridge(b => b.renomearSessao(renomearSessId, nome));
      const item = document.querySelector(`.sess-item[data-id="${renomearSessId}"]`);
      if (item) item.querySelector('.sess-nome').textContent = nome;
      if (renomearSessId === sessaoAtualId)
        document.getElementById('chat-nome').value = nome.toUpperCase();
    } else {
      _withBridge(b => b.renomearSessaoAtual(nome));
      document.getElementById('chat-nome').value = nome.toUpperCase();
    }
    renomearSessId = null;
    mostrarToast('// Nome salvo');
  }

  function salvarNome() {
    const nome = document.getElementById('chat-nome').value.trim();
    if (!nome) { document.getElementById('chat-nome').value = 'NOVA SESSÃO'; return; }
    _withBridge(b => b.renomearSessaoAtual(nome));
    mostrarToast('// Nome salvo');
  }

  function deletarSessao(id) {
    if (!confirm('Deletar essa sessão?')) return;
    deletados.add(id);
    _withBridge(b => b.deletarSessao(id));
    const item = document.querySelector(`.sess-item[data-id="${id}"]`);
    if (item) item.remove();
    if (id === sessaoAtualId) novaConversa();
    mostrarToast('// Sessão deletada');
    if (!document.querySelectorAll('.sess-item').length)
      document.getElementById('sess-empty').style.display = 'block';
  }

  function mostrarToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg; t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2000);
  }

  // ─── Mensagens ───
  function appendMessage(quem, texto, ts) {
    const w = document.getElementById('welcome'); if (w) w.style.display = 'none';
    const msgs = document.getElementById('messages');
    const wrapper = document.createElement('div'); wrapper.className = `msg ${quem}`;
    const av = document.createElement('div'); av.className = `avatar ${quem === 'user' ? 'user-av' : 'ai-av'}`;
    av.innerHTML = quem === 'user' ? '<span>AL</span>'
      : `<svg width="16" height="16" viewBox="0 0 50 50" fill="none">
          <polygon points="25,2 46,13.5 46,36.5 25,48 4,36.5 4,13.5"
            fill="rgba(139,44,245,0.1)" stroke="#8b2cf5" stroke-width="1.5"/>
          <circle cx="25" cy="25" r="4" fill="#a855f7"/>
        </svg>`;
    const col = document.createElement('div'); col.className = 'msg-col';
    const bubble = document.createElement('div');
    bubble.className = `bubble ${quem === 'user' ? 'user-bubble' : 'ai-bubble'}`;
    bubble.textContent = texto; col.appendChild(bubble);
    if (ts) {
      const tsEl = document.createElement('div'); tsEl.className = 'msg-ts';
      try { tsEl.textContent = '// ' + new Date(ts).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }); } catch {}
      col.appendChild(tsEl);
    }
    wrapper.appendChild(av); wrapper.appendChild(col); msgs.appendChild(wrapper);
    msgs.scrollTop = msgs.scrollHeight;
    return bubble;
  }

  function startStream() {
    const w = document.getElementById('welcome'); if (w) w.style.display = 'none';
    const msgs = document.getElementById('messages');
    const wrap = document.createElement('div'); wrap.className = 'thinking-wrap'; wrap.id = 'thinking';
    wrap.innerHTML = `
      <div class="avatar ai-av">
        <svg width="16" height="16" viewBox="0 0 50 50" fill="none">
          <polygon points="25,2 46,13.5 46,36.5 25,48 4,36.5 4,13.5"
            fill="rgba(139,44,245,0.1)" stroke="#8b2cf5" stroke-width="1.5"/>
          <circle cx="25" cy="25" r="4" fill="#a855f7"/>
        </svg>
      </div>
      <div class="thinking-bubble">
        PROCESSANDO
        <div class="thinking-dots"><span></span><span></span><span></span></div>
      </div>`;
    msgs.appendChild(wrap); msgs.scrollTop = msgs.scrollHeight;
  }

  function appendStream(token) {
    const thinking = document.getElementById('thinking');
    if (thinking) {
      thinking.remove();
      const msgs = document.getElementById('messages');
      const wrapper = document.createElement('div'); wrapper.className = 'msg ai'; wrapper.id = 'stream-wrapper';
      const av = document.createElement('div'); av.className = 'avatar ai-av';
      av.innerHTML = `<svg width="16" height="16" viewBox="0 0 50 50" fill="none">
        <polygon points="25,2 46,13.5 46,36.5 25,48 4,36.5 4,13.5"
          fill="rgba(139,44,245,0.1)" stroke="#8b2cf5" stroke-width="1.5"/>
        <circle cx="25" cy="25" r="4" fill="#a855f7"/>
      </svg>`;
      const col = document.createElement('div'); col.className = 'msg-col';
      streamBubble = document.createElement('div'); streamBubble.className = 'bubble ai-bubble typing';
      streamContent = '';
      col.appendChild(streamBubble); wrapper.appendChild(av); wrapper.appendChild(col);
      msgs.appendChild(wrapper);
    }
    if (streamBubble) {
      streamContent += token;
      streamBubble.textContent = streamContent;
      document.getElementById('messages').scrollTop = 99999;
    }
  }

  function endStream(resultado, nomeGerado, codigoJson, novaSessaoId) {
    if (streamBubble) streamBubble.classList.remove('typing');
    streamBubble  = null;
    streamContent = '';

    if (novaSessaoId && novaSessaoId !== 'null') {
      sessaoAtualId = novaSessaoId;
    }

    if (codigoJson && codigoJson !== 'null') {
      try {
        const cd = JSON.parse(codigoJson);
        if (cd.codigo) atualizarCodigo(cd.codigo, cd.sucesso);
      } catch(e) {}
    }

    if (resultado) {
      const msgs = document.getElementById('messages');
      const row  = document.createElement('div');
      row.style.cssText = 'padding:2px 44px;';
      const ok = resultado.startsWith('✅');
      row.innerHTML = `<span style="font-size:11px;letter-spacing:2px;color:${ok ? 'var(--green)' : 'var(--red)'}">${resultado}</span>`;
      msgs.appendChild(row); msgs.scrollTop = msgs.scrollHeight;
    }

    if (nomeGerado && nomeGerado !== 'null' && nomeGerado !== 'Nova conversa' && nomeGerado !== 'NOVA SESSÃO') {
      document.getElementById('chat-nome').value = nomeGerado.toUpperCase();
    }

    document.querySelectorAll('.sess-item').forEach(el =>
      el.classList.toggle('active', el.dataset.id === sessaoAtualId));

    setBusy(false);
  }

  function sendMessage() {
    if (ocupado) return;
    const input = document.getElementById('input');
    const texto = input.value.trim();
    if (!texto) return;
    input.value = '';
    document.getElementById('charCount').textContent = '0';
    autoResize();
    appendMessage('user', texto, new Date().toISOString());
    setBusy(true);
    startStream();
    _withBridge(b => b.enviarMensagem(texto));
  }

  function setMode(modo) {
    document.querySelectorAll('.nav-btn[id^="btn-"]').forEach(b => b.classList.remove('active'));
    const btnEl = document.getElementById(`btn-${modo}`);
    if (btnEl) btnEl.classList.add('active');
    document.getElementById('modeLabel').textContent = {
      chat: 'MODO: CONVERSA', cod: 'MODO: CÓDIGO', auto: 'MODO: AUTO'
    }[modo] || modo;
    modoAtual = modo;
    const input = document.getElementById('input');
    input.value = `/${modo}`;
    sendMessage();
  }

  function setBusy(val) {
    ocupado = val;
    document.getElementById('send-btn').disabled  = val;
    document.getElementById('input').disabled     = val;
    if (!val) document.getElementById('input').focus();
  }

  function autoResize() {
    const el = document.getElementById('input');
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 100) + 'px';
  }
</script>
</body>
