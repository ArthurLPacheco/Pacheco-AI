class Executor:

    def __init__(self, sandbox: str):
        self.sandbox = Path(sandbox)
        self.sandbox.mkdir(exist_ok=True)

    def executar(self, codigo: str) -> tuple[bool, str]:
        ok, motivo = AnalisadorSeguranca.analisar(codigo)
        if not ok:
            return False, f"[BLOQUEADO] {motivo}"

        nome    = f"exec_{int(time.time()*1000)}.py"
        caminho = self.sandbox / nome
        caminho.write_text(codigo, encoding="utf-8")

        try:
            env = os.environ.copy()
            env.update({"PYTHONIOENCODING": "utf-8", "PYTHONUTF8": "1",
                        "PYTHONDONTWRITEBYTECODE": "1"})
            r = subprocess.run(
                [sys.executable, "-X", "utf8", str(caminho)],
                capture_output=True, text=True,
                encoding="utf-8", errors="replace",
                timeout=CONFIG["timeout_execucao"], env=env,
            )
            out = self._limpar(r.stdout).strip()
            err = self._limpar(r.stderr).strip()
            if r.returncode != 0:
                return False, err or out or "Erro desconhecido"
            if not out:
                return False, "Código executou sem saída. Use print() FORA de funções."
            return True, out
        except subprocess.TimeoutExpired:
            return False, f"Timeout: execução ultrapassou {CONFIG['timeout_execucao']}s."
        except Exception as e:
            return False, f"Erro ao executar: {e}"
        finally:
            try:
                caminho.unlink()
            except:
                pass

    @staticmethod
    def _limpar(texto: str) -> str:
        return "\n".join(l for l in texto.splitlines()
                         if not any(r in l for r in RUIDO_DEBUGGER))


