class BancoDados:

    def __init__(self, caminho: str = DB_PATH):
        Path(caminho).parent.mkdir(parents=True, exist_ok=True)
        self.conn = sqlite3.connect(caminho, check_same_thread=False)
        self.conn.row_factory = sqlite3.Row
        self._criar_tabelas()

    def _criar_tabelas(self):
        self.conn.executescript("""
            CREATE TABLE IF NOT EXISTS sessoes (
                id         TEXT PRIMARY KEY,
                nome       TEXT NOT NULL DEFAULT 'Nova conversa',
                modo       TEXT NOT NULL DEFAULT 'chat',
                criada     TEXT NOT NULL,
                atualizada TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS mensagens (
                id        INTEGER PRIMARY KEY AUTOINCREMENT,
                sessao_id TEXT NOT NULL,
                role      TEXT NOT NULL,
                texto     TEXT NOT NULL,
                ts        TEXT NOT NULL,
                FOREIGN KEY(sessao_id) REFERENCES sessoes(id) ON DELETE CASCADE
            );
            CREATE TABLE IF NOT EXISTS memoria_longa (
                id      INTEGER PRIMARY KEY AUTOINCREMENT,
                ts      TEXT NOT NULL,
                usuario TEXT NOT NULL,
                codigo  TEXT,
                sucesso INTEGER NOT NULL DEFAULT 0
            );
            CREATE INDEX IF NOT EXISTS idx_msgs_sessao ON mensagens(sessao_id);
            PRAGMA foreign_keys = ON;
        """)
        self.conn.commit()

    def criar_sessao(self, sessao_id: str, modo: str = "chat") -> None:
        now = datetime.now().isoformat()
        self.conn.execute(
            "INSERT OR IGNORE INTO sessoes(id,nome,modo,criada,atualizada) VALUES(?,?,?,?,?)",
            (sessao_id, "Nova conversa", modo, now, now)
        )
        self.conn.commit()

    def renomear_sessao(self, sessao_id: str, novo_nome: str) -> None:
        self.conn.execute(
            "UPDATE sessoes SET nome=?, atualizada=? WHERE id=?",
            (novo_nome.strip()[:80], datetime.now().isoformat(), sessao_id)
        )
        self.conn.commit()

    def deletar_sessao(self, sessao_id: str) -> None:
        self.conn.execute("DELETE FROM sessoes WHERE id=?", (sessao_id,))
        self.conn.commit()

    def listar_sessoes(self) -> list[dict]:
        cur = self.conn.execute("""
            SELECT s.id, s.nome, s.modo, s.criada, s.atualizada,
                   COUNT(m.id) as total
            FROM sessoes s
            LEFT JOIN mensagens m ON m.sessao_id = s.id
            GROUP BY s.id
            ORDER BY s.atualizada DESC
        """)
        return [dict(r) for r in cur.fetchall()]

    def atualizar_modo_sessao(self, sessao_id: str, modo: str) -> None:
        self.conn.execute(
            "UPDATE sessoes SET modo=?, atualizada=? WHERE id=?",
            (modo, datetime.now().isoformat(), sessao_id)
        )
        self.conn.commit()

    def obter_sessao(self, sessao_id: str) -> Optional[dict]:
        cur = self.conn.execute("SELECT * FROM sessoes WHERE id=?", (sessao_id,))
        row = cur.fetchone()
        return dict(row) if row else None

    def adicionar_mensagem(self, sessao_id: str, role: str, texto: str) -> None:
        now = datetime.now().isoformat()
        self.conn.execute(
            "INSERT INTO mensagens(sessao_id,role,texto,ts) VALUES(?,?,?,?)",
            (sessao_id, role, texto, now)
        )
        self.conn.execute(
            "UPDATE sessoes SET atualizada=? WHERE id=?", (now, sessao_id)
        )
        self.conn.commit()

    def obter_mensagens(self, sessao_id: str, limite: int = 200) -> list[dict]:
        # CORREÇÃO v5.4: Subquery para retornar na ordem cronológica ASC
        cur = self.conn.execute("""
            SELECT role, texto, ts FROM (
                SELECT id, role, texto, ts FROM mensagens 
                WHERE sessao_id=? 
                ORDER BY id DESC LIMIT ?
            ) ORDER BY id ASC
        """, (sessao_id, limite))
        return [dict(r) for r in cur.fetchall()]

    def salvar_memoria(self, usuario: str, codigo: str, sucesso: bool) -> None:
        self.conn.execute(
            "INSERT INTO memoria_longa(ts,usuario,codigo,sucesso) VALUES(?,?,?,?)",
            (datetime.now().isoformat(), usuario, codigo, int(sucesso))
        )
        self.conn.commit()

    def buscar_memoria_similar(self, pergunta: str) -> Optional[str]:
        gatilhos = ("arquivo", "json", "estoque", "salvar", "ler", "leia", "venda", "produto",
                    "relatorio", "relatório", "csv", "docx", "pptx", "excel", "planilha",
                    "documento", "telegram", "email", "twilio")
        if not any(g in pergunta.lower() for g in gatilhos):
            return None
        cur = self.conn.execute(
            "SELECT usuario,codigo FROM memoria_longa WHERE sucesso=1 ORDER BY id DESC LIMIT 50"
        )
        palavras = set(pergunta.lower().split())
        best_s, best = 0.0, None
        for row in cur.fetchall():
            p2 = set(row["usuario"].lower().split())
            if not p2:
                continue
            s = len(palavras & p2) / len(palavras | p2)
            if s > best_s and s >= 0.45:
                best_s, best = s, row["codigo"]
        return best

    def contar_memorias(self) -> int:
        cur = self.conn.execute("SELECT COUNT(*) FROM memoria_longa WHERE sucesso=1")
        return cur.fetchone()[0]

    def fechar(self):
        self.conn.close()


