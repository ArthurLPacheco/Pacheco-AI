class CacheRespostas:
    def __init__(self, ttl: int = CONFIG["cache_ttl_segundos"]):
        self._cache: dict[str, tuple[str, float]] = {}
        self.ttl = ttl

    @staticmethod
    def _chave(texto: str) -> str:
        return hashlib.md5(texto.strip().lower().encode()).hexdigest()

    def get(self, texto: str) -> Optional[str]:
        chave = self._chave(texto)
        if chave in self._cache:
            resposta, ts = self._cache[chave]
            if time.time() - ts < self.ttl:
                return resposta
            del self._cache[chave]
        return None

    def set(self, texto: str, resposta: str):
        self._cache[self._chave(texto)] = (resposta, time.time())

    def limpar(self):
        self._cache.clear()


