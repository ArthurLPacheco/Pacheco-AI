class Sessao:
    def __init__(self, db: BancoDados, sessao_id: Optional[str] = None):
        self.db   = db
        self.id   = sessao_id or f"sess_{int(time.time()*1000)}"
        self.modo = CONFIG["modo_padrao"]
        self._dados: Optional[dict] = None
        self._nome_cache: Optional[str] = None

        if not sessao_id:
            db.criar_sessao(self.id, self.modo)

    def _carregar(self):
        if self._dados is None:
            self._dados = self.db.obter_sessao(self.id) or {}
            self.modo = self._dados.get("modo", CONFIG["modo_padrao"])

    @property
    def nome(self) -> str:
        if self._nome_cache is not None:
            return self._nome_cache
        self._carregar()
        return self._dados.get("nome", "Nova conversa")

    @nome.setter
    def nome(self, valor: str):
        valor = valor.strip()[:80]
        self._nome_cache = valor
        if self._dados is not None:
            self._dados["nome"] = valor
        self.db.renomear_sessao(self.id, valor)

    def adicionar_msg(self, role: str, texto: str):
        self.db.adicionar_mensagem(self.id, role, texto)

    def msgs(self, limite: int = 200) -> list[dict]:
        return self.db.obter_mensagens(self.id, limite)

    def set_modo(self, modo: str):
        self.modo = modo
        self.db.atualizar_modo_sessao(self.id, modo)


