class ClienteOllama:

    _LIXO_TOKENS = ("<html", "<!DOCTYPE", "<div", "<script", "<style", "<head", "<body")

    def __init__(self):
        self.session = requests.Session()

    def verificar(self) -> bool:
        try:
            return self.session.get("http://localhost:11434", timeout=3).status_code == 200
        except:
            return False

    def gerar(self, prompt: str, temperatura: Optional[float] = None,
              modelo: Optional[str] = None, silencioso: bool = False) -> str:
        if temperatura is None:
            temperatura = CONFIG["temperatura_codigo"]
        if modelo is None:
            modelo = CONFIG["modelo"]

        payload = {
            "model": modelo,
            "prompt": prompt,
            "stream": True,
            "options": {"temperature": temperatura, "num_predict": 2048}
        }
        resp = ""
        try:
            with self.session.post(CONFIG["url_ollama"], json=payload,
                                   stream=True, timeout=CONFIG["timeout_resposta"]) as r:
                r.raise_for_status()
                for linha in r.iter_lines():
                    if not linha:
                        continue
                    token = json.loads(linha.decode()).get("response", "")
                    if any(lixo in resp + token for lixo in self._LIXO_TOKENS):
                        break
                    if not silencioso:
                        print(token, end="", flush=True)
                    resp += token
        except requests.exceptions.ConnectionError:
            raise RuntimeError("Ollama offline. Execute: ollama serve")
        return resp

    def listar_modelos(self) -> list[str]:
        try:
            r = self.session.get("http://localhost:11434/api/tags", timeout=5)
            return [m["name"] for m in r.json().get("models", [])]
        except:
            return []


