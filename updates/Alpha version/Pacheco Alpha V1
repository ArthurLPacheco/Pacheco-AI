└─────────────────────────────────────────────────────────────────┘""")

    def _cmd_memoria(self):
        sessoes   = self.db.listar_sessoes()
        total_mem = self.db.contar_memorias()
        print(f"\n── MEMÓRIA v{self.VERSAO} ──")
        print(f"Sessões salvas: {len(sessoes)} conversas (SQLite)")
        print(f"Soluções salvas: {total_mem}")
        print(f"Cache ativo: {len(self.chat.cache._cache)} entradas")

    def _cmd_renomear(self, novo_nome: str):
        if not novo_nome:
            print("\n❌ Uso: /renomear <novo nome>")
            return
        self.sessao_atual.nome = novo_nome
        print(f"\n✅ Sessão renomeada para: {novo_nome}")

    def _cmd_apagar(self, id_sessao: str):
        if not id_sessao:
            print("\n❌ Uso: /apagar <id_sessao>  (veja os IDs com /sessoes)")
            return
        if not self.db.obter_sessao(id_sessao):
            print(f"\n❌ Sessão '{id_sessao}' não encontrada.")
            return
        self.db.deletar_sessao(id_sessao)
        if id_sessao == self.sessao_atual.id:
            print(f"\n🗑️  Sessão atual '{id_sessao}' foi apagada. Iniciando nova sessão.")
            self.nova_sessao()
        else:
            print(f"\n🗑️  Sessão '{id_sessao}' apagada com sucesso.")

    def _cmd_sessoes(self):
        sessoes = self.db.listar_sessoes()
        if not sessoes:
            print("\nNenhuma sessão encontrada.")
            return
        print(f"\n── SESSÕES SALVAS ({len(sessoes)}) ──")
        print(f"{'ID':<28} {'Nome':<35} {'Modo':<8} {'Msgs':<5} {'Atualizada'}")
        print("─" * 100)
        for s in sessoes:
            print(f"{s['id']:<28} {s['nome'][:34]:<35} {s['modo']:<8} {s['total']:<5} {s['atualizada'][:19]}")
        print(f"\nDica: use /apagar <id> para remover uma sessão.")

    def executar(self):
        print(f"\n  PACHECO AI Ω v{self.VERSAO} | LIMA CORP  by Arthur Lima")
        if not self.cliente.verificar():
            print("\n❌ Ollama offline! Execute: ollama serve")
            return

        modelos   = self.cliente.listar_modelos()
        sessoes   = self.db.listar_sessoes()
        total_mem = self.db.contar_memorias()
        print(f"\n  💬 Chat:   {CONFIG['modelo_chat']}")
        print(f"  ⌨️  Código: {CONFIG['modelo']}")
        print(f"  Módulos:   {len(_MODULOS_PERMITIDOS)} autorizados")
        print(f"  Sessões:   {len(sessoes)} (SQLite)")
        print(f"  Memória:   {total_mem} soluções")
        if modelos:
            print(f"  Ollama:    {', '.join(modelos)}")
        print("\n/chat · /cod · /auto · /renomear · /apagar · /sessoes · /ajuda\n")

        while True:
            try:
                print(f"\nVOCÊ {ICONE_MODO.get(self.modo_atual, '')}: ", end="")
                entrada = input()
                if entrada.strip():
                    self.rotear(entrada)

            except SystemExit as e:
                if str(e) == "sair":
                    print("\nFalou, Arthur! 👋")
                self.db.fechar()
                break
            except KeyboardInterrupt:
                print("\n[Ctrl+C] Use /sair pra encerrar.")
            except RuntimeError as e:
                print(f"\n❌ ERRO: {e}")
                break
            except Exception as e:
                import traceback
                print(f"\n❌ [ERRO] {e}\n{traceback.format_exc()}")
                self.logger.log("FATAL", traceback.format_exc())


if __name__ == "__main__":
    ai = PachecoAI()
