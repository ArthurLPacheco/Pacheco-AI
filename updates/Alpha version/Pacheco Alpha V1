class ControladorNavegador:

    CHROME_PATHS = [
        r"C:\Program Files\Google\Chrome\Application\chrome.exe",
        r"C:\Program Files (x86)\Google\Chrome\Application\chrome.exe",
        r"C:\Users\{user}\AppData\Local\Google\Chrome\Application\chrome.exe",
        "/usr/bin/google-chrome",
        "/usr/bin/chromium-browser",
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    ]

    @classmethod
    def _encontrar_chrome(cls) -> str:
        if CONFIG.get("chrome_path") and Path(CONFIG["chrome_path"]).exists():
            return CONFIG["chrome_path"]
        user = os.environ.get("USERNAME", os.environ.get("USER", ""))
        for p in cls.CHROME_PATHS:
            caminho = p.format(user=user)
            if Path(caminho).exists():
                CONFIG["chrome_path"] = caminho
                return caminho
        return ""

    @classmethod
    def abrir(cls, url: str) -> str:
        if not url.startswith(("http://", "https://")):
            url = "https://" + url
        chrome = cls._encontrar_chrome()
        try:
            if chrome:
                subprocess.Popen([chrome, url])
                return f"✅ Aberto no Chrome: {url}"
            else:
                webbrowser.open(url)
                return f"✅ Aberto no navegador padrão: {url}"
        except Exception as e:
            return f"❌ Erro ao abrir: {e}"


