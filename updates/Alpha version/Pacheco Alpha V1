    def __init__(self, cliente: "ClienteOllama"):
        self.cliente  = cliente
        self.historico: list[dict] = []
        self.cache    = CacheRespostas()

    def gerar_nome(self, msg: str) -> str:
        prompt = (
            "Título curto (máx 5 palavras, sem aspas, sem ponto) para conversa:\n"
            f'"{msg[:200]}"\nResposta APENAS com o título.'
        )
        try:
            n = self.cliente.gerar(prompt, temperatura=0.3,
                                   modelo=CONFIG["modelo_chat"], silencioso=True).strip()
            n = re.sub(r'^["\']|["\']$', '', n).strip(" .")
            return n[:60] if n else "Nova conversa"
        except:
            return "Nova conversa"

    def responder(self, pergunta: str, complexidade: str,
                  historico_sessao: Optional[list[dict]] = None) -> str:
        cache_key = f"{complexidade}:{pergunta}"
        cached = self.cache.get(cache_key)
        if cached:
            print(cached, end="", flush=True)
            return cached

        trocas = self._comprimir_historico(historico_sessao or self.historico)

        ctx = ""
        if trocas:
            ctx = "HISTÓRICO RECENTE:\n"
            for t in trocas:
                role = "Arthur" if t.get("role") == "user" else "Pacheco"
                ctx += f"{role}: {t.get('texto', '')[:180]}\n"
            ctx += "\n"

        inst = {
            "simples":  "1-2 frases, sem listas.",
            "medio":    "3-6 frases, pode usar lista se ajudar.",
            "complexo": "Seja completo. Use estrutura clara com tópicos.",
        }.get(complexidade, "Direto ao ponto.")

        prompt = (
            f"{self.SYSTEM_CHAT}\n\n{ctx}"
            f"TAMANHO: {inst}\n\n"
            f"Arthur: {pergunta}\nPacheco:"
        )

        resp = self.cliente.gerar(prompt, temperatura=CONFIG["temperatura_chat"],
                                  modelo=CONFIG["modelo_chat"])
        resp = self._truncar_delirio(resp)
        resp = self._remover_codigo(resp)
        resp = resp.strip()

        if complexidade in ("simples", "medio") and len(resp) < 800:
            self.cache.set(cache_key, resp)

        self.historico.append({"role": "user", "texto": pergunta})
        self.historico.append({"role": "ai", "texto": resp})
        if len(self.historico) > 24:
            self.historico = self.historico[-24:]

        return resp

    def _comprimir_historico(self, msgs: list[dict]) -> list[dict]:
        limite = CONFIG["max_historico_sessao"]
        msgs_filtradas = [m for m in msgs if m.get("role") in ("user", "ai")]
        return msgs_filtradas[-limite:]

    def limpar(self):
        self.historico.clear()
        self.cache.limpar()

    @staticmethod
    def _remover_codigo(texto: str) -> str:
        AVISO = "\n[Use /cod — lá eu gero esse código no Modo Programador.]\n"
        t = re.sub(r'```[\w]*\s*\n.*?\n\s*```', AVISO, texto, flags=re.DOTALL)
        t = re.sub(r'```.*?```', AVISO, t, flags=re.DOTALL)
        t = re.sub(r'(\$Use /cod[^\$]+\$\n?){2,}', AVISO, t)
        return t.strip()

    @staticmethod
    def _truncar_delirio(texto: str) -> str:
        pos = len(texto)
        for g in ("\nArthur:", "\nVocê:", "\nUser:", "\nUsuário:",
                  "\nARTHUR:", "\nVOCÊ:", "\nUSER:"):
            i = texto.find(g)
            if i != -1 and i < pos:
                pos = i
        return texto[:pos].strip()


