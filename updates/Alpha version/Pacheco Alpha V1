            "Automação": ["pyautogui","keyboard","mouse","schedule","watchdog","paramiko"],
            "Imagem":    ["PIL","cv2"],
            "Mensagens": ["telegram","twilio","yagmail","sendgrid"],
            "Util":      ["rich","tqdm","click","pydantic","loguru","cryptography","qrcode"],
            "Sistema":   ["psutil","GPUtil","pygetwindow","pytesseract"],
        }
        print(f"\n── MÓDULOS v{self.VERSAO} ({len(_MODULOS_PERMITIDOS)} total) ──")
        for cat, mods in cats.items():
            pips = " | ".join(f"{m}" for m in mods)
            print(f"  {cat}: {pips}")

    def _cmd_ajuda(self):
        print(f"""
┌─ PACHECO AI Ω v{self.VERSAO} ── AJUDA ─────────────────────────────┐
│  💬 Chat:      {CONFIG['modelo_chat']:<48}│
│  ⌨️  Código:   {CONFIG['modelo']:<48}│
│                                                                 │
│  MODO:    /chat  /cod  /auto                                    │
│  INFO:    /hora  /data  /versao  /memoria  /modulos             │
│  BROWSER: /abrir <url>   → abre no Chrome                       │
│  SESSÃO:  /renomear <nome>   /apagar <id>   /sessoes            │
