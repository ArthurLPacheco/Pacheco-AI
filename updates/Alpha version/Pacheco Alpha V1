class Classificador:
    @staticmethod
    def classificar(texto: str) -> str:
        t = texto.lower().strip()
        if any(g in t for g in _GATILHOS_CODIGO_FORTE):
            return "codigo"
        sc = sum(1 for g in _GATILHOS_CODIGO_FRACO if g in t)
        sv = sum(1 for g in _GATILHOS_CONVERSA if g in t)
        if sc > sv + 1:  return "codigo"
        if sv > 0:       return "chat"
        if sc > 0:       return "codigo"
        return "chat"

    @staticmethod
    def estimar_complexidade(texto: str) -> str:
        t, w = texto.lower(), len(texto.split())
        gatilhos = (
            "quais são", "quais sao", "me lista", "me explica detalhado",
            "quais as vantagens", "quais os", "como posso", "como eu posso",
            "estratégia", "estrategia", "comparação", "diferença entre",
            "me dê exemplos", "ideia de negócio", "produtos que", "o que seria",
        )
        if any(g in t for g in gatilhos) or w > 15: return "complexo"
        if w <= 5:  return "simples"
        return "medio"


