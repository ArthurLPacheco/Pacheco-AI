#  BRIDGE Python ↔ JavaScript
# ══════════════════════════════════════════════════════════════

class Bridge(QObject):
    """Expõe métodos Python pro JavaScript chamar."""

    # Sinais — única forma thread-safe de comunicar com a UI no PyQt6
    sinalJS     = pyqtSignal(str)
    sinalEnviar = pyqtSignal(str)

    def __init__(self, view: QWebEngineView, ai: PachecoAI):
        super().__init__()
        self.view = view
        self.ai   = ai
        self.sinalJS.connect(self._executar_js)
        self.sinalEnviar.connect(self._processar)

    def _executar_js(self, code: str):
        """Sempre chamado na main thread via sinal."""
        self.view.page().runJavaScript(code)

    def js(self, code: str):
        """Thread-safe: emite sinal que executa JS na main thread."""
        self.sinalJS.emit(code)

    @pyqtSlot(str)
    def enviarMensagem(self, texto: str):
        """Chamado pelo JS — emite sinal pra processar."""
        self.sinalEnviar.emit(texto)

    @pyqtSlot()
    def uiPronta(self):
        pass

    def _processar(self, texto: str):
        """Dispara thread de processamento sem travar a UI."""
        threading.Thread(target=self._rodar, args=(texto,), daemon=True).start()

    def _rodar(self, texto: str):
        original_stdout = sys.stdout
        bridge_ref = self

        class StreamCapture:
            def write(self, t):
                if t:
                    safe = (t.replace("\\", "\\\\")
                             .replace("`", "\\`")
                             .replace("'", "\\'")
                             .replace("\n", "\\n")
                             .replace("\r", ""))
                    bridge_ref.sinalJS.emit(f"appendStream(\'{safe}\')")
            def flush(self): pass

        sys.stdout = StreamCapture()
        resultado_str = ""

        try:
            if texto.lower() in ("/sair", "sair", "exit"):
                self.sinalJS.emit("window.close()")
                return
            self.ai.rotear(texto)
        except SystemExit:
            self.sinalJS.emit("window.close()")
            return
        except Exception as e:
            resultado_str = f"❌ Erro: {e}"
        finally:
            sys.stdout = original_stdout

        modo = self.ai.modo_atual
        labels = {"chat": "💬 CONVERSA", "codigo": "⌨️  CÓDIGO", "auto": "🤖 AUTOMÁTICO"}
        label = labels.get(modo, modo)
        safe_res = resultado_str.replace("'", "\'")
        self.sinalJS.emit(f"document.getElementById(\'modeLabel\').textContent = \'{label}\';")
        self.sinalJS.emit(f"endStream(\'{safe_res}\')")


