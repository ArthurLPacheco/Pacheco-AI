class JanelaPacheco(QMainWindow):

    def __init__(self):
        super().__init__()
        self.setWindowTitle("Pacheco AI Ω | LIMA CORP")
        self.setMinimumSize(1000, 680)
        self.resize(1200, 780)

        # Tenta setar ícone
        icon_path = os.path.join(os.path.dirname(__file__), "icon.png")
        if os.path.exists(icon_path):
            self.setWindowIcon(QIcon(icon_path))

        # WebView
        self.view = QWebEngineView()
        settings = self.view.settings()
        settings.setAttribute(QWebEngineSettings.WebAttribute.JavascriptEnabled, True)
        settings.setAttribute(QWebEngineSettings.WebAttribute.LocalContentCanAccessRemoteUrls, True)

        self.setCentralWidget(self.view)
        self.view.setHtml(HTML, QUrl("qrc:/"))

        # Inicia Pacheco na main thread após a página carregar
        self.view.loadFinished.connect(self._init_pacheco)

    def _init_pacheco(self, ok=True):
        # Tudo na main thread — sem threading aqui
        ai     = PachecoAI()
        online = ai.cliente.verificar()
        mem    = len(ai.memoria.longo_prazo)
        modelo = CONFIG["modelo"]

        self.bridge = Bridge(self.view, ai)

        # WebChannel — tudo na main thread, sem problema
        channel = QWebChannel(self.view.page())
        channel.registerObject("bridge", self.bridge)
        self.view.page().setWebChannel(channel)

        js_channel = """
            (function() {
                var s = document.createElement('script');
                s.src = 'qrc:///qtwebchannel/qwebchannel.js';
                s.onload = function() {
                    new QWebChannel(qt.webChannelTransport, function(channel) {
                        window.bridge = channel.objects.bridge;
                    });
                };
                document.head.appendChild(s);
            })();
        """
        online_js = 'true' if online else 'false'
        js_status = f"setStatus({online_js}, '{modelo}', {mem});"

        self.view.page().runJavaScript(js_channel)
        QTimer.singleShot(800, lambda: self.view.page().runJavaScript(js_status))


