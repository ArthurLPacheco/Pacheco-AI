  // Exposta pro Python chamar via runJavaScript
  function setStatus(online, modelo, memoriaLen) {
    const dot  = document.getElementById('statusDot');
    const text = document.getElementById('statusText');
    const tag  = document.getElementById('modelTag');
    const badge = document.getElementById('headerBadge');

    if (online) {
      dot.className  = 'status-dot online';
      text.textContent = '● Online';
      badge.textContent = `v3.2 · ${memoriaLen} soluções`;
    } else {
      dot.className  = 'status-dot offline';
      text.textContent = '● Offline — ollama serve';
      badge.textContent = 'Offline';
    }
    tag.textContent = modelo;
  }

  function appendMessage(quem, texto) {
    hideWelcome();
    const msgs = document.getElementById('messages');

    const wrapper = document.createElement('div');
    wrapper.className = `msg ${quem}`;

    const av = document.createElement('div');
    av.className = `avatar ${quem === 'user' ? 'user-av' : 'ai-av'}`;
    av.innerHTML = quem === 'user'
      ? '<span>AL</span>'
      : '<svg width="18" height="18" viewBox="0 0 64 64" fill="none"><path d="M10 38 L18 20 L32 14 L46 20 L54 38 L46 44 L32 46 L18 44 Z" fill="#252540"/><path d="M32 18 L33.5 26 L40 28 L33.5 30 L32 38 L30.5 30 L24 28 L30.5 26 Z" fill="#9d5ff0"/></svg>';

    const bubble = document.createElement('div');
    bubble.className = `bubble ${quem === 'user' ? 'user-bubble' : 'ai-bubble'}`;
    bubble.textContent = texto;

    wrapper.appendChild(av);
    wrapper.appendChild(bubble);
    msgs.appendChild(wrapper);
    msgs.scrollTop = msgs.scrollHeight;
    return bubble;
  }

  function startStream() {
    hideWelcome();
    const msgs = document.getElementById('messages');

    // Thinking indicator
    const thinking = document.createElement('div');
    thinking.className = 'msg ai';
    thinking.id = 'thinking';
    thinking.innerHTML = `
      <div class="avatar ai-av">
        <svg width="18" height="18" viewBox="0 0 64 64" fill="none">
          <path d="M10 38 L18 20 L32 14 L46 20 L54 38 L46 44 L32 46 L18 44 Z" fill="#252540"/>
